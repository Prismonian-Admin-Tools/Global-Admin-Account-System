  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "js-yaml": "^4.1.0",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1"
  }
