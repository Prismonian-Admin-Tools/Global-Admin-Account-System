# =============================================================================
# GAM (Global Admin Account System, formerly GUS) — configuration
# =============================================================================

server:
  bind: "127.0.0.1"
  port: 9200
  # Signs GAM's OWN frontend session cookie (used when a person logs
  # into auth.prismonian.com directly). Unrelated to the opaque app tokens
  # issued to client apps — change this to something random.
  sessionSecret: "CHANGE_ME_TO_A_RANDOM_STRING"
  # Encrypts values GAM must be able to read back later: the SMTP
  # password, a user's MFA secret, and the OIDC signing key at rest.
  # Deliberately a SEPARATE secret from sessionSecret — one key now
  # covering two unrelated jobs (signing session cookies AND protecting
  # data at rest) meant a leak of either purpose compromised both, and
  # rotating sessionSecret silently broke decryption of everything else.
  # Change this to a different random value than sessionSecret. Rotating
  # it means re-entering the SMTP password and any enrolled MFA secrets
  # (users just re-run setup) afterward.
  encryptionKey: "CHANGE_ME_TO_A_DIFFERENT_RANDOM_STRING"
  # Public base URL, used for building absolute avatar links.
  publicUrl: "https://auth.prismonian.com"
  # Whether (and how much) to trust X-Forwarded-For for the caller's real
  # IP — used for login-lockout and rate-limiting. Leave `false` (the
  # default) unless GAM sits behind a reverse proxy that OVERWRITES this
  # header before forwarding (nginx/Caddy/etc. do this by default).
  # Trusting it with nothing in front means any caller can set their own
  # req.ip per request just by sending the header, defeating the login
  # lockout entirely. If you do run behind such a proxy, set this to the
  # number of proxy hops between the internet and GAM (usually 1).
  trustProxy: false

database:
  host: "127.0.0.1"
  port: 5432
  name: "gus"
  user: "gus"
  password: "CHANGE_ME"
  ssl: false

avatars:
  directory: "./data/avatars"

# Every account starts here on creation, per design: forced password
# change on first login, no exceptions.
newAccountDefaults:
  mustChangePassword: true
  role: "staff"

session:
  # How long an app-issued opaque token stays valid without being used.
  # Each successful /validate call slides this window forward.
  idleTimeoutMinutes: 720   # 12 hours, matches Console's old cookie maxAge
  # Hard ceiling regardless of activity — forces re-login eventually even
  # for a token that's used constantly.
  absoluteTtlDays: 30

rateLimit:
  login:
    # Per (username, source IP) pair.
    maxAttempts: 5
    windowMinutes: 15
    lockoutMinutes: 15
  perApp:
    # Overall request budget per calling application, so one misbehaving
    # or compromised app can't hammer the whole service.
    maxRequestsPerMinute: 240

activity:
  file: "./data/activity.yml"

failedLogins:
  file: "./data/failed-logins.yml"

# Emailed one-time links ("Reset password" in password-expiry emails,
# "Wasn't you?" in new-sign-in and password-changed emails). Each works
# once, and any password change cancels the account's outstanding links.
# Links point at server.publicUrl, so that must be Passport's real address.
resetLinks:
  ttlHours: 72

# Where an unfamiliar sign-in came from (city, ISP, VPN warning) for the
# "new sign-in" email. The IP address always comes from the request.
ipLookup:
  # Use visitor-location headers added by a proxy/CDN in front of Passport
  # (Cloudflare: Network → "Add visitor location headers"). ONLY turn this
  # on if such a proxy really is in front — otherwise anyone can send these
  # headers and pick their own "city".
  trustLocationHeaders: false
  locationHeaders:
    city: "cf-ipcity"
    region: "cf-region"
    country: "cf-ipcountry"
  # Everything the request doesn't carry (always ISP + VPN detection) comes
  # from proxycheck.io. This sends each unfamiliar sign-in's IP address to
  # proxycheck.io. Without a key it allows ~100 lookups/day; a free account
  # key raises that to 1,000. PROXYCHECK_API_KEY overrides apiKey.
  proxycheck:
    enabled: true
    apiKey: ""
    timeoutSeconds: 4

# Rally account sync (WSAPI v2.0). When enabled, every Passport account
# created from now on gets a matching Rally user, and disabling,
# re-enabling or deleting the Passport account does the same to that
# Rally user. Accounts that existed before you turned this on are not
# touched until you enroll them: `npm run cli -- rally sync <username>`.
# Rally requires an email address, so an account without one waits until
# an email is set. See README → "Rally account sync".
rally:
  # Easiest: leave enabled false and connect Rally from the website instead
  # — Apps tab → RESTful API → "Rally (WSAPI)" + API key. That key is stored
  # encrypted, takes effect without a restart, and wins over the one below.
  # enabled + apiKey here are only needed to configure the key in this file.
  enabled: false
  baseUrl: "https://rally1.rallydev.com"
  # A Rally API key for a Rally Subscription Administrator (only they can
  # create users). Sent as the ZSESSIONID header. The RALLY_API_KEY
  # environment variable overrides this, if you'd rather not keep the key
  # in this file.
  apiKey: ""
  # What deleting a Passport account does to its Rally user:
  #   disable — (default) disable it. Keeps the Rally user's stories,
  #             defects, tasks and revision history intact; reversible.
  #   delete  — permanently delete it in Rally. Cannot be undone.
  # Either way, a Rally user that already existed and was only LINKED by
  # email (not created by Passport) is only ever disabled, never deleted.
  onPassportDelete: "disable"
  # Failed Rally calls are retried in the background on this interval, up
  # to maxAttempts times (then `npm run cli -- rally retry` to try again).
  retryIntervalMinutes: 15
  maxAttempts: 10
  requestTimeoutSeconds: 15
  # Required fields on every new Rally user. Allowed values per the WSAPI
  # spec: language/locale "US English" or "None"; sessionTimeout (seconds)
  # one of 600, 900, 1800, 3600, 7200, 14400, 21600, 28800, 36000,
  # 432000, 1209600.
  userDefaults:
    language: "US English"
    locale: "US English"
    sessionTimeout: 3600
  # Importing existing Rally users (`rally import-list` / `rally import`):
  # the Passport rank a newly-created account gets, from the Rally user's
  # subscription permission. Accounts that are only LINKED to an existing
  # Passport account keep whatever rank they already have.
  import:
    roleMap:
      subscriptionAdmin: "systemAdministrator"
      workspaceAdmin: "elevatedStaff"
      default: "staff"
